# Build directory
build/

# ESP-IDF Configuration files (user-specific, auto-generated)
sdkconfig
sdkconfig.old
sdkconfig.old.*

# Compiled binaries
*.bin
*.elf
*.map

# Flash arguments (generated during build)
flasher_args.json
flash_*_args

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Python cache (ESP-IDF uses Python)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# Logs
*.log
logs/

# PlatformIO (if used)
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# CMake (if generated outside build/)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*~
